{
  "name": "car-details-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "owner:create": "tsx scripts/create-owner.ts",
    "db:indexes": "tsx scripts/indexes.ts",
    "seed:dev": "tsx scripts/seed.ts",
    "workbook:inspect": "tsx scripts/inspect-workbook.ts",
    "bookings:inspect": "tsx scripts/inspect-bookings.ts",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "test:smoke": "npm run build && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "read-excel-file": "^9.3.14",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "write-excel-file": "^4.1.1"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}
