# Local development only. Set a hosted MongoDB URI on Render.
MONGODB_URI=mongodb://127.0.0.1:27017/car_details
PORT=5000
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Required locally AND in Render's Environment settings. Keep the same value across restarts.
JWT_SECRET=
# Set only when running tests; the database name must start with car_details_test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/car_details_test
